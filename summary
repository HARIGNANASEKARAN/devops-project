#!/bin/bash
# =========================================
# DevOps Practice Notes: Docker, Compose, Kubernetes, HPA, Git
# Collected from interactive session
# =========================================

# -------------------------
# 1. Docker Basics
# -------------------------
# Build Docker image
docker build -t devops-project .

# Common errors:
# ❌ /bin/sh: 1: [python,: not found
# Cause: Incorrect CMD/ENTRYPOINT formatting
# Fix: Use JSON array in Dockerfile
# CMD ["python", "app.py"]

# Check running containers
docker ps

# Stop/remove container to fix port conflicts
docker stop <container_name_or_id>
docker rm <container_name_or_id>

# Check which ports are in use (Windows PowerShell)
netstat -ano | findstr :5000

# -------------------------
# 2. Docker Compose
# -------------------------
# Run services in detached mode
docker compose up -d

# Stop and remove all services
docker compose down

# View logs
docker compose logs -f web
docker compose logs -f db

# Common error:
# ❌ additional properties 'db' not allowed
# Fix: Ensure 'db' service is under 'services:' in docker-compose.yml

# -------------------------
# 3. Python & Dependencies
# -------------------------
# Enter container bash
docker exec -it devops-project-web-1 bash

# Test Python & DB connection
python
# >>> import psycopg2
# >>> conn = psycopg2.connect("postgres://postgres:password@db:5432/devopsdb")
# >>> cur = conn.cursor()
# >>> cur.execute("SELECT 1;")
# >>> cur.fetchone()
# >>> conn.close()

# ❌ ModuleNotFoundError: No module named 'psycopg2'
# Fix: Add psycopg2 to requirements.txt
# RUN pip install -r requirements.txt in Dockerfile

# -------------------------
# 4. Kubernetes (Minikube)
# -------------------------
# Start minikube
minikube start

# Load local Docker image to Minikube
minikube image load devops-project

# Apply deployment
kubectl apply -f deployment.yaml

# Check pods
kubectl get pods -w

# Expose service
kubectl expose deployment devops-app --type=NodePort --port=5000

# Access service via Minikube
minikube service devops-service

# -------------------------
# 5. Horizontal Pod Autoscaler (HPA)
# -------------------------
# Create HPA: scale 2→5 pods on CPU >50%
kubectl autoscale deployment devops-app --cpu-percent=50 --min=2 --max=5

# Generate load
kubectl run -i --tty load-generator --image=busybox -- /bin/sh
# while true; do wget -q -O- http://devops-service:5000; done

# Watch pods scale
kubectl get pods -w

# Note: Autoscaling may take >1 minute to reflect

# -------------------------
# 6. Git & Remote Issues
# -------------------------
# Switch to HTTPS to avoid SSH key issues
git remote set-url origin https://github.com/HARIGNANASEKARAN/devops-project.git
git push -u origin main

# -------------------------
# 7. Tooling (Windows)
# -------------------------
# Helm installation check
helm version
# ❌ CommandNotFound
# Fix: Install Helm via Scoop or Chocolatey

# Install Scoop (PowerShell)
Set-ExecutionPolicy RemoteSigned -scope CurrentUser
iwr -useb get.scoop.sh | iex

# Install Chocolatey (PowerShell)
Set-ExecutionPolicy Bypass -Scope Process -Force
iwr https://community.chocolatey.org/install.ps1 -UseBasicParsing | iex

# -------------------------
# 8. Notes / Best Practices
# -------------------------
# - Dockerfile: always use WORKDIR and COPY correctly
# - Python: ensure dependencies installed inside container
# - Kubernetes: imagePullPolicy=Never for local images
# - DB URLs cannot be accessed via browser; use API endpoints or psql client
# - HPA requires metrics-server installed
# - Minikube services require open terminal on Windows for tunneling


#!/bin/bash
# ======================================================
# DevOps Troubleshooting & Key Learnings (Bash Notes)
# ======================================================

# 1️⃣ Minikube service blocking terminal
# - Problem: Docker driver keeps terminal busy
# - Resolution:
#     * Stop with Ctrl+C
#     * Or use: kubectl port-forward service/devops-service 5000:5000
#     * Open browser manually: http://localhost:5000

# 2️⃣ Chocolatey installation issues
# - Problem: Partially installed, temp folder locked, 'choco' not recognized
# - Resolution:
#     * Remove temp folder: rm -rf /c/Users/dhaar/AppData/Local/Temp/chocolatey
#     * Reinstall Chocolatey from Admin PowerShell
#     * Restart system if needed

# 3️⃣ PowerShell Execution Policy
# - Temporary bypass: Set-ExecutionPolicy Bypass -Scope Process
# - Check policies: Get-ExecutionPolicy -List

# 4️⃣ PATH not updated
# - Problem: Tools like helm, scoop not recognized
# - Resolution:
export PATH="$PATH:$HOME/scoop/shims"
# - Verify:
which scoop
which helm

# 5️⃣ Base64 not recognized
# - Linux/Bash: echo "cGFzc3dvcmQ=" | base64 --decode
# - Windows PowerShell:
#   [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String("cGFzc3dvcmQ="))

# 6️⃣ Scoop install issues (7-Zip / coreutils)
# - Problem: URL invalid, network timeout, dependency failures
# - Resolution:
scoop bucket rm main
scoop bucket add main
# Optional: Manual 7-Zip install from https://www.7-zip.org

# 7️⃣ Scoop bucket confusion
# - Buckets are repos, not packages
# - Commands:
scoop bucket list          # list buckets
scoop bucket add main      # add missing bucket
scoop bucket rm main       # remove bucket if needed

# 8️⃣ coreutils installed but commands missing
# - Issue: PATH not updated to include coreutils bin
export PATH="$PATH:$HOME/scoop/apps/coreutils/current/bin"
# - Verify: ls $HOME/scoop/apps/coreutils/current/bin

# 9️⃣ refreshenv not recognized
# - Only available in Chocolatey, not Scoop

# 🔟 Kubernetes Grafana password decoding
# - Bash/Linux:
kubectl get secret monitoring-grafana \
  -o jsonpath="{.data.admin-password}" | base64 --decode
# - Copy to clipboard:
kubectl get secret monitoring-grafana \
  -o jsonpath="{.data.admin-password}" | base64 --decode | xclip -selection clipboard
# - PowerShell alternative:
# [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String(
#    (kubectl get secret monitoring-grafana -o jsonpath="{.data.admin-password}")
# ))

# 1️⃣1️⃣ Scoop coreutils commands
# - Installed commands include: true, uname, uniq, wc, base64
# - May need to reference full path on Windows

# 1️⃣2️⃣ Key Lessons
# - Windows ≠ Linux: prefer native tools when possible
# - PATH misconfiguration is a common source of errors
# - Scoop may fail due to network/dependency issues
# - Buckets (repos) vs packages: understand difference
# - Use kubectl + base64 directly for secrets decoding
# - PowerShell native commands often more reliable on Windows

# ======================================================
# End of Bash Notes
