#!/bin/bash
# ===============================================
# DevOps Practice - Learning Notes & Commands
# ===============================================

# ----------------------------
# 1️⃣ Docker Basics & Errors
# ----------------------------

# Check Docker version
docker --version

# Build Docker image
# ❌ Common Error: no build stage
docker build -t devops-project .

# Dockerfile example
cat <<'EOF' > Dockerfile
FROM python:3.9

WORKDIR /app
COPY . .
RUN pip install -r requirements.txt
CMD ["python", "app.py"]
EOF

# Check running containers
docker ps

# Stop/remove conflicting containers
# ❌ Error: port already allocated
docker stop <container_id>
docker rm <container_id>

# Run container
docker run -p 5000:5000 devops-project

# ----------------------------
# 2️⃣ Python & Dependencies
# ----------------------------

# Add dependencies to requirements.txt
echo -e "Flask\npsycopg2-binary" > requirements.txt

# Rebuild Docker image if dependencies added
docker build -t devops-project .

# Test inside container
docker exec -it devops-project-web-1 bash
# python
# >>> import psycopg2
# >>> conn = psycopg2.connect("postgres://postgres:password@db:5432/devopsdb")
# >>> cur = conn.cursor()
# >>> cur.execute("SELECT 1;")
# >>> print(cur.fetchone())
# >>> conn.close()

# ----------------------------
# 3️⃣ Docker Compose
# ----------------------------

# Compose YAML example (v3, no 'version' needed)
cat <<'EOF' > docker-compose.yml
services:
  web:
    build: .
    ports:
      - "5000:5000"
    environment:
      - DATABASE_URL=postgres://postgres:password@db:5432/devopsdb
    depends_on:
      - db

  db:
    image: postgres:14
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
      POSTGRES_DB: devopsdb
EOF

# Start services
docker compose up -d

# Stop services
docker compose down

# View logs
docker compose logs -f web
docker compose logs -f db

# ----------------------------
# 4️⃣ Kubernetes Basics
# ----------------------------

# Check Minikube status
minikube status

# Load Docker image into Minikube
minikube image load devops-project

# Example deployment.yaml
cat <<'EOF' > deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: devops-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: devops-app
  template:
    metadata:
      labels:
        app: devops-app
    spec:
      containers:
      - name: devops-container
        image: devops-project
        imagePullPolicy: Never
        ports:
        - containerPort: 5000
EOF

# Apply deployment
kubectl apply -f deployment.yaml

# Check pods
kubectl get pods -w

# Delete existing pod if error: AlreadyExists
kubectl delete pod load-generator

# Run test load generator
kubectl run -i --tty load-generator --image=busybox -- /bin/sh
# Inside pod: while true; do wget -q -O- http://devops-service:5000; done

# ----------------------------
# 5️⃣ Autoscaling (HPA)
# ----------------------------

# Enable Horizontal Pod Autoscaler
kubectl autoscale deployment devops-app --cpu-percent=50 --min=2 --max=5

# Watch HPA
kubectl get hpa -w

# Trigger CPU load to test scaling
# while true; do wget -q -O- http://devops-service:5000; done

# ----------------------------
# 6️⃣ Services & Networking
# ----------------------------

# Expose service in Minikube
kubectl expose deployment devops-app --type=NodePort --name=devops-service

# Open service URL
minikube service devops-service

# Reminder: PostgreSQL (port 5432) is not HTTP
# Use Flask API endpoints for browser:
# http://localhost:5000/
# http://localhost:5000/health

# ----------------------------
# 7️⃣ Tooling & Windows Notes
# ----------------------------

# Helm not found? Install via Scoop or Chocolatey
# Scoop:
# powershell -Command "iwr -useb get.scoop.sh | iex"
# scoop install helm
# Chocolatey:
# Set-ExecutionPolicy Bypass -Scope Process -Force
# iex ((New-Object System.Net.WebClient).DownloadString('https://chocolatey.org/install.ps1'))
# choco install kubernetes-helm

# Windows alternative to grep
kubectl get pods -n kube-system | Select-String metrics-server

# ----------------------------
# 8️⃣ Git & SSH
# ----------------------------
# ❌ Permission denied (publickey)
# Fix: Use HTTPS instead of SSH
# git remote set-url origin https://github.com/<username>/<repo>.git

# ----------------------------
# ✅ Summary Checks
# ----------------------------
docker ps
docker compose ps
kubectl get pods
kubectl get hpa
kubectl logs <pod_name>

echo "All DevOps learning notes & common errors collected!"