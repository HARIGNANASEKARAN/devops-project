# -------------------------------
# 1. Minikube service blocks terminal
# -------------------------------
# Issue:
# Using Docker driver on Windows, terminal gets stuck
# Resolution:
# Stop with Ctrl+C or use port-forward
kubectl port-forward service/devops-service 5000:5000
# Then access in browser: http://localhost:5000

# -------------------------------
# 2. Chocolatey install failed / partially installed
# -------------------------------
# Issue:
# Chocolatey installer detects previous installation
# Access denied on temp files
# Resolution:
# Remove temp folder (Git Bash/WSL)
rm -rf /c/Users/dhaar/AppData/Local/Temp/chocolatey
# Restart system if needed
# Reinstall Chocolatey in Admin PowerShell

# -------------------------------
# 3. PowerShell execution policy confusion
# -------------------------------
# Check policy:
# Windows-only
# Get-ExecutionPolicy -List
# Temporary bypass (current session only)
# Set-ExecutionPolicy Bypass -Scope Process

# -------------------------------
# 4. PATH not updated after installing tools
# -------------------------------
# Issue:
# Helm or Scoop not recognized after installation
# Resolution:
export PATH="$PATH:$HOME/scoop/shims"
# Verify:
which helm
which scoop

# -------------------------------
# 5. base64 not recognized in PowerShell
# -------------------------------
# Linux/Bash:
echo "cGFzc3dvcmQ=" | base64 --decode
# Windows PowerShell alternative:
# [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String("cGFzc3dvcmQ="))

# -------------------------------
# 6. Scoop installation issues (7-Zip, coreutils)
# -------------------------------
# Issue:
# URL invalid / network timeout
# 7-Zip dependency fails → coreutils cannot install
# Resolution:
scoop bucket rm main
scoop bucket add main
# Optional manual install:
# 1. Download 7-Zip manually
# 2. Install coreutils: scoop install coreutils

# -------------------------------
# 7. Scoop bucket confusion
# -------------------------------
# Issue:
# 'main' bucket errors: "isn't installed" or "already exists"
# Explanation:
# Buckets are repositories, not packages
scoop bucket list          # list all buckets
scoop bucket add main      # add bucket if missing
scoop bucket rm main       # remove bucket if needed

# -------------------------------
# 8. coreutils installed but base64 still not found
# -------------------------------
# Issue:
# Windows shims not loaded properly
# Resolution:
ls $HOME/scoop/apps/coreutils/current/bin
# Add to PATH manually:
export PATH="$PATH:$HOME/scoop/apps/coreutils/current/bin"

# -------------------------------
# 9. refreshenv not recognized
# -------------------------------
# Cause:
# Only available from Chocolatey, not Scoop
# Windows-only

# -------------------------------
# 10. Kubernetes Grafana password decoding
# -------------------------------
# Linux/Bash:
kubectl get secret monitoring-grafana \
  -o jsonpath="{.data.admin-password}" | base64 --decode
# Copy to clipboard (Linux):
kubectl get secret monitoring-grafana \
  -o jsonpath="{.data.admin-password}" | base64 --decode | xclip -selection clipboard

# Windows PowerShell equivalent:
# [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String(
#    (kubectl get secret monitoring-grafana -o jsonpath="{.data.admin-password}")
# ))

# -------------------------------
# 11. Scoop coreutils / Linux-like commands
# -------------------------------
# Installed coreutils includes commands like:
# true, uname, uniq, wc
# On Windows, may need to call via:
# $HOME/scoop/apps/coreutils/current/bin/base64.exe
# Or add to PATH for shorthand usage

# -------------------------------
# 12. Key lessons / best practices
# -------------------------------
# - Windows is not Linux → use native tools when possible
# - PATH issues are the most common cause of "command not recognized"
# - Scoop can fail due to network or dependency issues (7-Zip)
# - Prefer PowerShell native commands on Windows
# - Use Bash native commands on Linux
# - Buckets vs packages in Scoop: Buckets = repos, Packages = software
# - Use kubectl + PowerShell/Bash directly for tasks like decoding secrets

